# Satellite Orbit Tracker – Environment Variables
# Copy this file to .env and adjust as needed.

# Cache TTL in seconds (default: 7200 = 2 hours)
CACHE_TTL_SECONDS=7200

# Server host and port
HOST=0.0.0.0
PORT=8000

# KeepTrack API v4 key (backend only). Optional; CelesTrak is used when unset.
# Never commit real values. Get a free key from https://api.keeptrack.space
KEEPTRACK_API_KEY=your-keeptrack-api-key
KEEPTRACK_BASE_URL=https://api.keeptrack.space

# Full catalog cache TTLs
CATALOG_CACHE_TTL_SECONDS=7200
SATCAT_CACHE_TTL_SECONDS=86400
SATCAT_URL=https://celestrak.org/satcat/records.php?FORMAT=JSON&MAX=150000
